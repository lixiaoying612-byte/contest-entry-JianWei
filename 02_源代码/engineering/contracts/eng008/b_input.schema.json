{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ENG008 B input",
  "type": "object",
  "properties": {
    "candidate_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "company",
              "industry"
            ]
          },
          "target_code": {
            "type": "string",
            "pattern": "\\S"
          },
          "target_name": {
            "type": "string",
            "pattern": "\\S"
          },
          "event_name": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "definition_id",
          "target_type",
          "target_code",
          "target_name",
          "event_name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "document": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "publication_time",
        "source",
        "text"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "title": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "properties": {
            "text": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mention_ref": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "pattern": "\\S"
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "role": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "name",
                    "role",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "object",
                "properties": {
                  "phase": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "polarity": {
                    "type": "string",
                    "enum": [
                      "affirmed",
                      "negated",
                      "unclear"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "asserted",
                      "planned",
                      "forecast",
                      "conditional",
                      "question",
                      "unclear"
                    ]
                  },
                  "attributed_to": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "context": {
                    "type": "string",
                    "enum": [
                      "focus",
                      "background",
                      "unclear"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "phase",
                  "polarity",
                  "mode",
                  "attributed_to",
                  "context",
                  "evidence_refs"
                ],
                "additionalProperties": false
              },
              "times": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "occurrence",
                        "effective",
                        "deadline",
                        "observation",
                        "unspecified"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "normalized": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "precision": {
                      "type": "string",
                      "enum": [
                        "year",
                        "month",
                        "day",
                        "datetime",
                        "interval",
                        "relative",
                        "unknown"
                      ]
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "explicit",
                        "document_context",
                        "publication_time",
                        "unresolved"
                      ]
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "role",
                    "text",
                    "normalized",
                    "precision",
                    "basis",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                }
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "value_text": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "name",
                    "value_text",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                }
              },
              "matches": {
                "type": "array",
                "const": []
              },
              "impact_mentions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target_name": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "positive",
                        "negative",
                        "neutral",
                        "mixed",
                        "unclear"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "asserted",
                        "planned",
                        "forecast",
                        "conditional",
                        "question",
                        "unclear"
                      ]
                    },
                    "attributed_to": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "quote": {
                      "type": "object",
                      "properties": {
                        "section": {
                          "type": "string",
                          "enum": [
                            "title",
                            "body"
                          ]
                        },
                        "quote": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "section",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "target_name",
                    "direction",
                    "mode",
                    "attributed_to",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "evidence_quotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "section": {
                      "type": "string",
                      "enum": [
                        "title",
                        "body"
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "section",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "uncertainties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "summary",
              "participants",
              "status",
              "times",
              "details",
              "matches",
              "impact_mentions",
              "evidence_quotes",
              "uncertainties"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mention_ref",
          "event"
        ],
        "additionalProperties": false
      }
    },
    "a_check": {
      "type": "object",
      "properties": {
        "schema_status": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_status": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_issues": {
          "type": "array"
        },
        "semantic_review_status": {
          "const": "pending"
        }
      },
      "required": [
        "schema_status",
        "evidence_status",
        "evidence_issues",
        "semantic_review_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "candidate_definitions",
    "document",
    "mentions",
    "a_check"
  ],
  "additionalProperties": false
}