{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ENG-007 v2 model input",
  "type": "object",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "publication_time",
        "source",
        "text"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "title": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "properties": {
            "text": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "candidate_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "company",
              "industry"
            ]
          },
          "target_code": {
            "type": "string",
            "pattern": "\\S"
          },
          "target_name": {
            "type": "string",
            "pattern": "\\S"
          },
          "event_name": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "definition_id",
          "target_type",
          "target_code",
          "target_name",
          "event_name",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "document",
    "candidate_definitions"
  ],
  "additionalProperties": false
}
